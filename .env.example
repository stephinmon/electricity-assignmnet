# Copy to .env in the repo root. Compose loads this file automatically.
# Do not commit .env.
#
# Host is the workspace hostname only (no https://).
# PAT is the same Databricks token used in .dlt/secrets.toml.

AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://token:<databricks-pat>@<workspace-host>
